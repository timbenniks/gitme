{
  "name": "gitme",
  "version": "0.1.0",
  "description": "Multi-account GitHub CLI — manage SSH keys, git identities, and GitHub auth per repo",
  "keywords": [
    "cli",
    "git",
    "github",
    "multi-account",
    "ssh"
  ],
  "homepage": "https://github.com/timbenniks/gitme#readme",
  "bugs": {
    "url": "https://github.com/timbenniks/gitme/issues"
  },
  "license": "MIT",
  "author": "Tim Benniks",
  "repository": {
    "type": "git",
    "url": "https://github.com/timbenniks/gitme.git"
  },
  "bin": {
    "gitme": "./bin/gitme.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "vp pack",
    "dev": "tsx src/index.ts",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:coverage": "vp test run --coverage",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "typecheck": "tsc --noEmit",
    "check": "vp check",
    "prepublishOnly": "npm run build",
    "prepare": "vp config"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "commander": "^14.0.3",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite-plus": "latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.12.0"
}
